APP_NAME="De Luxe Aesthetic Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ADMIN_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Accra

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deluxaesthetic
DB_USERNAME=root
DB_PASSWORD=

# Local alternative:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production behind HTTPS:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production: set MAIL_MAILER=smtp (or ses/postmark) with real credentials.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BUSINESS_NAME="De Luxe Aesthetic Clinic"
BUSINESS_LEGAL_NAME="De Luxe Aesthetic Clinic"
BUSINESS_WORDMARK="De Luxe"
BUSINESS_LOGO_SUBTITLE="Aesthetic Clinic"
BUSINESS_EMAIL=luxeaetheticsacademy@gmail.com
BUSINESS_PHONE=+233552248636
BUSINESS_WHATSAPP=+233552248636
BUSINESS_ADDRESS="East Legon, Dr Tagoe Avenue, GA-375-8490, Accra, Ghana"
BUSINESS_HOURS="Daily · 7:00am–7:00pm"
BUSINESS_MAP_EMBED_URL=
BUSINESS_MAP_LINK=
DEFAULT_CURRENCY=GHS
DEFAULT_LOCALE=en
CEO_NAME="Dr Evelyn Ejaife"
CEO_TITLE="CPD licensed Aesthetic Trainer and Specialist"

PAYMENT_DRIVER=paystack
# Local default is mock. Production MUST set PAYMENT_MOCK=false and real Paystack keys.
PAYMENT_MOCK=true
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=

SMS_DRIVER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=DeLux

WHATSAPP_DRIVER=mock
WHATSAPP_API_URL=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

AI_ENABLED=true
AI_DRIVER=mock
AI_PROVIDER=openai
AI_API_KEY=
AI_API_URL=
AI_MODEL=gpt-4o-mini
AI_RATE_LIMIT=10
AI_RETENTION_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console Authorized redirect URI exactly (use HTTPS in production).
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=

EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_LOGGING_ENABLED=true
EMAIL_DEFAULT_LOCALE=en
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY_SECONDS=300
EMAIL_ADMIN_ALERT_ADDRESS=
EMAIL_SUPPORT_ADDRESS=
EMAIL_BOOKINGS_ADDRESS=
EMAIL_ACADEMY_ADDRESS=
EMAIL_STORE_ADDRESS=

GOOGLE_MAPS_API_KEY=
ANALYTICS_MEASUREMENT_ID=

MEDIA_DISK=public
MEDIA_PRIVATE_DISK=local
MEDIA_MAX_UPLOAD_KB=5120

SEED_ADMIN_EMAIL=admin@deluxaesthetic.test
SEED_ADMIN_PASSWORD=
SEED_CEO_EMAIL=ceo@deluxaesthetic.test
SEED_CEO_PASSWORD=
SEED_CLIENT_EMAIL=client@deluxaesthetic.test
SEED_CLIENT_PASSWORD=
SEED_STUDENT_EMAIL=student@deluxaesthetic.test
SEED_STUDENT_PASSWORD=
SEED_TRAINER_EMAIL=trainer@deluxaesthetic.test
SEED_TRAINER_PASSWORD=
SEED_DEFAULT_PASSWORD=
